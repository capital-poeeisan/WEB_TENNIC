@model List<WEB_TENNIC.Models.ViewModels.ProjectViewModel>

<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">

    <h3 class="mb-0 text-primary fw-bold" id="pg-header">
        <i class="fas fa-project-diagram me-2"></i>
        Project List
    </h3>

</div>

<div class="card shadow  py-2 px-1">
    <div class="card-body " style="padding-top:0px!important;">
        @*  <div class="card shadow-sm h-100 table-card"> *@

        @*  <div class="card-header fw-semibold">
                        <i class="fas fa-table me-2"></i>
                        Project List
                    </div> *@
        <div class="d-flex align-items-center gap-3 mt-3" style="padding-top:0px!important">
            <form asp-action="Index" method="get" id="searchForm" class="form-check me-3">
                <input type="checkbox"
                       class="form-check-input border-2 border-dark"
                       name="EndFlag"
                       id="chkEndFlag"
                       style="align-items: !important"
                       value="1"
                       @(ViewBag.EndFlag == 1 ? "checked" : "") />

                <label class="form-check-label fw-semibold align-items-center"
                       style="align-items:center !important" for="chkEndFlag">
                    ALL
                </label>

                &nbsp;&nbsp;
                <button class="btn btn-primary  px-4 ms-3 shadow-sm px-4"
                        id="btnShow "
                        type="submit">
                    表示
                </button>
                @* <button type="submit" class="btn btn-primary btn-sm btn-search ">
                                            表示
                                     </button> *@

            </form>
        </div>
        @*   <div class="card-body"> *@
        <div class="table-responsive">
            <table id="projectTable"
                   class="table table-sm table-hover table-bordered table-striped align-middle mb-0 table-edit small">
                <thead class="table-info">
                    <tr>
                        <th class="text-center w-auto">
                            No.
                        </th>
                        <th>
                            プロジェクト名
                        </th>
                        <th class="text-center w-auto">
                            終了
                        </th>
                        <th class="text-center w-auto">
                        </th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.No</td>
                            <td>@item.ProjectName</td>
                            <td>@item.EndFlag</td>
                            <td>
                                @*  @if (item.EndFlag != "◯")
                                { *@
                                <a class="btn btn-outline-primary btn-sm" style="font:200!important;" onclick="location.href='@Url.Action("Index", "ProjectDetail")'">
                                    Detail
                                </a>
                                @* <a href="/ProjectDetail/Index">
                                        Detail
                                    </a> *@
                                @*   } *@

                            </td>

                        </tr>

                    }

                </tbody>
            </table>


        </div>
        @*   </div> *@

        @*  </div> *@


        <div class="d-flex justify-content-center gap-3 mt-3">

            <div class="card-footer bg-light border-0 text-center">
                <a class="btn btn-outline-secondary px-4" onclick="location.href='@Url.Action("Index", "ProjectList")'">
                    クリア
                </a>
                <button id="btnSave" type="button" onclick="location.href='@Url.Action("Index", "ImportExcel")'" class="btn btn-success  px-4 ms-3 ">
                    新しい Project
                </button>
            </div>

        </div>

    </div>
</div>

<style>

    .form-check {
        display: flex;
        align-items: center;
        margin-bottom: 0;
    }

    .form-check-input {
        margin-top: 0;
        width: 1.3rem;
        height: 1.3rem;
        cursor: pointer;
    }

    .form-check-label {
        margin-left: 6px;
        font-weight: bold;
        /*       margin-left: 5px; */
    }

    .toolbar {
        padding-left: 12px !important;
        padding-right: 12px !important;
    }

    .px-2 {
        padding-top: 1rem !important;
        padding-right: 1rem !important;
        padding-left: 1rem !important;
    }

    #projectTable th:nth-child(1),
    #projectTable td:nth-child(1) {
        width: 60px;
        text-align: center;
    }

    #projectTable th:nth-child(3),
    #projectTable td:nth-child(3) {
        width: 100px;
        text-align: center;
    }

    #projectTable th:nth-child(4),
    #projectTable td:nth-child(4) {
        width: 100px;
        text-align: center;
    }


    .btn-search {
        /* min-width: 90px; */
        background-color: #0c63e4 !important;
    }

</style>


@section Scripts {
    <script>

                  $(document).ready(function () {

                var table = $('#projectTable').DataTable({
                    paging: true,
                    searching: true,
                    ordering: true,
                    info: true,
                    lengthChange: false,
                    responsive: true,
                    autoWidth: false,
                    order: [[0, 'desc']]
                });


                function addAllButton() {

                    if ($('#btnShowAll').length === 0) {

                        $('.dt-paging ul').append(`
                            <li class="dt-paging-button page-item">
                                <button id="btnShowAll"
                                        class="page-link"
                                        type="button">
                                    ALL
                                </button>
                            </li>
                        `);

                    }

                }



                addAllButton();



                table.on('draw', function () {
                    addAllButton();
                });


                $(document).on('click', '#btnShowAll', function () {
                    table.page.len(-1).draw();
                });


                document.querySelector('.d-md-flex')
                    .prepend(document.getElementById('searchForm'));

            });





           document.getElementById("searchForm").addEventListener("submit", function () {

            const checkbox = document.getElementById("chkEndFlag");

            if (checkbox.checked) {

               document.getElementById("chkEndFlag").value=1;

            }
            else {

               document.getElementById("chkEndFlag").value=0;

            }

        });

    </script>
}







