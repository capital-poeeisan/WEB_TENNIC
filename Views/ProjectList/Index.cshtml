@model List<WEB_TENNIC.Models.ViewModels.ProjectViewModel>

<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">

    <h3 class="mb-0 text-primary fw-semibold" id="pg-header">
        <i class="fas fa-project-diagram me-2"></i>
        Project List
    </h3>

</div>

<div class="card shadow  py-2 px-1">
    <div class="card-body " style="padding-top:0px!important;">
       
        <div class="d-flex align-items-center gap-3 mt-3" style="padding-top:0px!important">
            <form asp-action="Index" method="get" id="searchForm" class="form-check me-3">
                <input type="checkbox"
                       class="form-check-input border-2 border-dark"
                       name="EndFlag"
                       id="chkEndFlag"
                       style="align-items: !important"
                       value="1"
                       @(ViewBag.EndFlag == 1 ? "checked" : "") />

                <label class="form-check-label fw-semibold align-items-center"
                       style="align-items:center !important" for="chkEndFlag">
                    全て
                </label>

                &nbsp;&nbsp;
                <button class="btn btn-primary  px-4 ms-3 shadow-sm px-4"
                        id="btnShow "
                        type="submit">
                    表示
                </button>               

            </form>
        </div>
        <div class="table-responsive table-scroll">
            <table id="projectTable"
                   class="table table-hover table-bordered align-middle table-striped mb-0">
                <thead class="table-success">
                    <tr>
                        <th class="text-center" style="width:5%;">No.</th>
                        <th style="width:40%;">プロジェクト名</th>
                        <th class="text-start" style="width:35%;">ファイル名</th>
                        <th class="text-center" style="width:10%;">終了</th>
                        <th class="text-center" style="width:10%;"></th>
                      @*   <th class="text-center" style="width:5%;"></th> *@
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.No</td>

                            <td class="text-truncate"
                                title="@item.ProjectName">
                                @item.ProjectName
                            </td>

                            <td class="text-truncate"
                                title="@item.FileName">
                                @item.FileName
                            </td>

                            <td class="text-center">@item.EndFlag</td>

                            <td class="text-center text-nowrap">
                                <a class="btn btn-outline-success btn-sm me-2 fw-semibold"
                                   onclick="location.href='@Url.Action("Index", "ProjectDetail", new { projectCd = item.ProjectCD })'">
                                    明細
                                </a>
                                <a class="btn btn-outline-primary btn-sm me-2 fw-semibold"
                                   onclick="location.href='@Url.Action("Index", "ImportExcelUpdate", new { projectCd = item.ProjectCD })'">
                                    修正
                                </a>
                                <a class="btn btn-outline-danger btn-sm me-2 fw-bold btnDeletePrj"  data-projectcd="@item.ProjectCD">
                                    削除
                                </a>
                            </td>
                        
                        </tr>
                    }
                </tbody>
            </table>
        </div>
      
        <div class="d-flex justify-content-center gap-3 mt-3">

            <div class="card-footer bg-light border-0 text-center">
                <a class="btn btn-outline-secondary px-4" onclick="location.href='@Url.Action("Index", "ProjectList")'">
                    クリア
                </a>
                <button id="btnSave" type="button" onclick="location.href='@Url.Action("Index", "ImportExcel")'" class="btn btn-success  px-4 ms-3 ">
                    新しい Project
                </button>
            </div>

        </div>

    </div>
</div>

<style>
    .table-scroll {
        height: calc(100vh - 300px);
        overflow-y: auto;
        overflow-x: auto;
    }

        .table-scroll thead th {
            position: sticky;
            top: 0;
            z-index: 10;
            background: #d9ebe4;
        }

    .table {
        white-space: nowrap;
    }

    .form-check {
        display: flex;
        align-items: center;
        margin-bottom: 0;
    }

    .form-check-input {
        margin-top: 0;
        width: 1.3rem;
        height: 1.3rem;
        cursor: pointer;
    }

    .form-check-label {
        margin-left: 6px;
        font-weight: bold;
        /*       margin-left: 5px; */
    }

    .toolbar {
        padding-left: 12px !important;
        padding-right: 12px !important;
    }

    .px-2 {
        padding-top: 1rem !important;
        padding-right: 1rem !important;
        padding-left: 1rem !important;
    }

    #projectTable th:nth-child(1),
    #projectTable td:nth-child(1) {
        width: 60px;
        text-align: center;
    }

    #projectTable th:nth-child(3),
    #projectTable td:nth-child(3) {
        width: 100px;
        text-align: left;
    }

    #projectTable th:nth-child(4),
    #projectTable td:nth-child(4) {
        width: 100px;
        text-align: center;
    }

    .btn-search {
        /* min-width: 90px; */
        background-color: #0c63e4 !important;
    }

</style>


@section Scripts {
    <script>

           $(document).ready(function () {

                var table = $('#projectTable').DataTable({
                    paging: true,
                    searching: true,
                    ordering: true,
                    info: true,
                    lengthChange: false,
                    // lengthChange: true,
                    // lengthMenu:[10,20,30,50,-1],
                    responsive: true,
                    autoWidth: false,
                    order: [],
                     columnDefs: [
                    {
                        targets: 4,   // No column
                        orderable: false
                    }
                ],
                     pageLength: 10
                     ,
                     /*  scrollY: '60vh',  */  // Vertical Height
                    scrollCollapse: true
                });

                addAllButton();

                table.on('draw', function () {
                    addAllButton();
                });


                $(document).on('click', '#btnShowAll', function () {
                        table.page.len(-1).draw();
                         $('.dt-paging-button').removeClass('current active');                         
                         $('#btnShowAll').addClass("dt-paging-button page-item active");
                });


                document.querySelector('.d-md-flex')
                    .prepend(document.getElementById('searchForm'));


                document.getElementById("searchForm").addEventListener("submit", function () {

                const checkbox = document.getElementById("chkEndFlag");

                if (checkbox.checked) {
                   document.getElementById("chkEndFlag").value=1;
                }
                else {
                   document.getElementById("chkEndFlag").value=0;
                }

                });

                $(document).on("click", ".btnDeletePrj", function () {

                   var projectCD = $(this).data("projectcd");
                  
                  var message = "本当に削除しますか？";
                Swal.fire({
                     title: "確認？",
                 showCancelButton: true,
                 confirmButtonText: "削除",
                 cancelButtonText: "キャンセル",
                   html: message,
                  confirmButtonText: 'はい',
                               width: '360px',
                               customClass: {
                                     popup: 'my-popup',
                                     title: 'title-question',
                                       confirmButton: 'delete-btn',
                                        cancelButton:'cancecl-btn'
                               },
                 buttonsStyling: false
                }).then((result) => {

                if (result.isConfirmed) {
                    $.ajax({
                url:"/ProjectList/DeleteProject/"+projectCD,
                type: "POST",   
                contentType: "application/json",
                success: function () {

                    Swal.fire({
                         title: '成功!',
                        html: "削除しました。",
                      confirmButtonText: "はい",
                             width: '360px',
                             customClass: {
                                 popup: 'my-popup',
                                 title: 'my-title-success',
                                 confirmButton: 'success-btn'
                             },
                             buttonsStyling: false
                                }).then(() => {
                          location.reload();
                              });

                },
                error: function () {
                    Swal.fire({
                        title: "エラー",
                        text: "削除　できません。",
                           confirmButtonText: 'はい',
                                 width: '360px',
                                 customClass: {
                                     popup: 'my-popup',
                                     title: 'my-title',
                                     confirmButton: 'my-button'
                                 },
                                 buttonsStyling: false
                    }).then(() => {
                          location.reload();
                              });
　　　          }　
                });
           }
            });


        });

             
           });
          function addAllButton() {
                    if ($('#btnShowAll').length === 0) {
                        $('.dt-paging ul').append(`
                            <li class="dt-paging-button page-item">
                                <button id="btnShowAll"
                                        class="page-link"
                                        type="button">
                                    ALL
                                </button>
                            </li>`
                        );
                    }
                }

    </script>
}







