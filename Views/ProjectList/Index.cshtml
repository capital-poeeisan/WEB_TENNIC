@model List<WEB_TENNIC.Models.ViewModels.ProjectViewModel>

<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">

    <h3 class="mb-0 text-primary fw-semibold" id="pg-header">
        <i class="fas fa-project-diagram me-2"></i>
        プロジェクト一覧
    </h3>

</div>

<div class="card shadow-sm table-card">
    <div class="card-body progress-card card-body-padding">
       
        <div class="d-flex align-items-center gap-3 mt-3 card-body-padding">
            <form asp-action="Index" method="get" id="searchForm" class="form-check F_check me-3">
                <input type="checkbox"
                       class="form-check-input border-2 border-dark"
                       name="EndFlag"
                       id="chkEndFlag"
                       style="align-items: !important"
                       value="1"
                       @(ViewBag.EndFlag == 1 ? "checked" : "") />

                <label class="form-check-label fw-semibold align-items-center"
                        id="chk_label1" for="chkEndFlag">
                    全て
                </label>

                &nbsp;&nbsp;
                <button class="btn btn-primary  px-4 ms-3 shadow-sm px-4"
                        id="btnShow "
                        type="submit">
                    表示
                </button>               

            </form>
        </div>
        <div class="table-responsive  table-scroll1">
            <table id="projectTable"
                   class="table project-table  table-hover table-bordered align-middle table-striped mb-0">
                <thead class="table-success">
                    <tr>
                        <th class="text-center col-no">No.</th>
                        <th class="col-project">プロジェクト名</th>
                        <th class="text-start col-file" hidden>ファイル名</th>
                        <th class="text-center col-end">終了</th>
                        <th class="text-center col-action"></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.No</td>

                            <td class="text-truncate"
                                title="@item.ProjectName">
                                @item.ProjectName
                            </td>

                            <td class="text-truncate"
                                title="@item.FileName" hidden>
                                @item.FileName
                            </td>

                            <td class="text-center">@item.EndFlag</td>

                            <td class="text-center text-nowrap">
                                <a class="btn btn-outline-success btn-sm me-2 fw-semibold"
                                   asp-controller="ProjectDetail"
                                   asp-action="Index"
                                   asp-route-projectCd="@item.ProjectCD">
                                    明細
                                </a>
                                <a class="btn btn-outline-primary btn-sm me-2 fw-semibold"
                                   onclick="location.href='@Url.Action("Index", "ImportExcelUpdate", new { projectCd = item.ProjectCD })'">
                                    修正
                                </a>
                                <a class="btn btn-outline-danger btn-sm me-2 fw-bold btnDeletePrj"  data-projectcd="@item.ProjectCD">
                                    削除
                                </a>
                                <a class="btn btn-outline-primary  btn-sm me-2 btnDownloadPrj "
                                   data-id="@item.ProjectCD" data-filename="@item.FileName" >
                                   <i class="fas fa-download"></i>
                                </a>
                              
                            </td>
                        
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
      
       @*  <div class="d-flex justify-content-center gap-3 mt-3"> *@

        <div class="card-footer bg-light border-0 text-center">
                <a class="btn btn-outline-secondary px-4 fw-semibold" onclick="location.href='@Url.Action("Index", "ProjectList")'">
                    クリア
                </a>
                <button id="btnSave" type="button" onclick="location.href='@Url.Action("Index", "ImportExcel")'" class="btn btn-success  px-4 ms-3 fw-semibold ">
                 プロジェクトを作る
                </button>
            </div>

       @*  </div> *@

 
</div>



@section Scripts {
    <script>

          $(document).ready(function () {

                var table = $('#projectTable').DataTable({
                    paging: true,
                    searching: true,
                    ordering: true,
                    info: true,
                    lengthChange: false,
                    // lengthChange: true,
                    // lengthMenu:[10,20,30,50,-1],
                    responsive: true,
                    autoWidth: false,
                    order: [],
                     columnDefs: [
                    {
                        targets: 4,   // No column
                        orderable: false
                    }
                ],
                     pageLength: 10
                     ,
                     /*  scrollY: '60vh',  */  // Vertical Height
                    scrollCollapse: true
                });

                addAllButton();

                table.on('draw', function () {
                    addAllButton();
                });


                $(document).on('click', '#btnShowAll', function () {
                        table.page.len(-1).draw();
                         $('.dt-paging-button').removeClass('current active');                         
                         $('#btnShowAll').addClass("dt-paging-button page-item active");
                });


                document.querySelector('.d-md-flex')
                    .prepend(document.getElementById('searchForm'));


                document.getElementById("searchForm").addEventListener("submit", function () {

                const checkbox = document.getElementById("chkEndFlag");

                if (checkbox.checked) {
                   document.getElementById("chkEndFlag").value=1;
                }
                else {
                   document.getElementById("chkEndFlag").value=0;
                }

                });

                $(document).on("click", ".btnDeletePrj", function () {

                   var projectCD = $(this).data("projectcd");
                  
                  var message = "本当に削除しますか？";
                Swal.fire({
                 title: "確認？",
                 showCancelButton: true,
                 confirmButtonText: "削除",
                 cancelButtonText: "キャンセル",
                   html: message,
                  confirmButtonText: 'はい',
                               width: '360px',
                               customClass: {
                                     popup: 'my-popup',
                                     title: 'title-question',
                                       confirmButton: 'delete-btn',
                                        cancelButton:'cancecl-btn'
                               },
                 buttonsStyling: false
                }).then((result) => {

                if (result.isConfirmed) {
                    $.ajax({
                url: '@Url.Action("DeleteProject", "ProjectList")/' + projectCD,
                type: "POST",   
                contentType: "application/json",
                success: function () {

                    Swal.fire({
                         title: '成功!',
                        html: "削除しました。",
                      confirmButtonText: "はい",
                             width: '360px',
                             customClass: {
                                 popup: 'my-popup',
                                 title: 'my-title-success',
                                 confirmButton: 'success-btn'
                             },
                             buttonsStyling: false
                                }).then(() => {
                          location.reload();
                              });

                },
                error: function () {
                    Swal.fire({
                        title: "エラー",
                        text: "削除　できません。",
                           confirmButtonText: 'はい',
                                 width: '360px',
                                 customClass: {
                                     popup: 'my-popup',
                                     title: 'my-title',
                                     confirmButton: 'my-button'
                                 },
                                 buttonsStyling: false
                    }).then(() => {
                          location.reload();
                              });
　　　          }　
                });
           }
            });


        });

               
                $(document).on("click", ".btnDownloadPrj", async function ()
                {

                    var id = $(this).data("id");
                    var filename = $(this).data("filename");

                    try {
                        
                        const result = await 
                        Swal.fire({
                             title: "確認？",
                             showCancelButton: true,
                             confirmButtonText: "削除",
                             cancelButtonText: "キャンセル",
                             html:"ダウンロードしますか？",
                             confirmButtonText: 'はい',
                             width: '360px',
                             customClass: {
                                     popup: 'my-popup',
                                     title: 'title-question',
                                     confirmButton: 'confirm-btn',
                                     cancelButton:'cancecl-btn'
                               },
                            buttonsStyling: false
                        });
                        
                        if (!result.isConfirmed) {
                            return;
                        }

                        // // Open file picker
                        // const handle = await window.showSaveFilePicker({
                        //     suggestedName: filename,
                        //     types: [
                        //         {
                        //             description: "Excel File",
                        //             accept: {
                        //                 "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"]
                        //             }
                        //         }
                        //     ]
                        // }); 
                        
                        $.ajax({
                            url: '@Url.Action("DownloadProject", "ProjectList")',
                            type: "POST",

                            data: {
                                id: id
                            },

                            xhrFields: {
                                responseType: "blob"
                            },

                            success: async function (data) {

                                // const writable = await handle.createWritable();

                                // await writable.write(data);

                                // await writable.close();
                                var url = window.URL.createObjectURL(data);

                                var a = document.createElement("a");

                                a.href = url;
                                a.download = filename;

                                document.body.appendChild(a);

                                a.click();

                                document.body.removeChild(a);

                                window.URL.revokeObjectURL(url);

                                // Swal.fire({
                                //     title: '成功!',
                                //     html: "ダウンロードが完了しました。",
                                //     confirmButtonText: "はい",
                                //     width: '360px',
                                //     customClass: {
                                //         popup: 'my-popup',
                                //         title: 'my-title-success',
                                //         confirmButton: 'success-btn'
                                //     },
                                //     buttonsStyling: false
                                // }).then(() => {
                                //     location.reload();
                                // });
                            },

                            error: function (xhr) {

                                console.log("status =", xhr.status);
                                console.log("response =", xhr.response);

                                Swal.fire({
                                    title: "エラー",
                                    html: "ファイルがないよ。",
                                    confirmButtonText: 'はい',
                                    width: '360px',
                                    customClass: {
                                        popup: 'my-popup',
                                        title: 'my-title',
                                        confirmButton: 'my-button'
                                    },
                                    buttonsStyling: false
                                });
                            }
                        });

                    } catch (err) {                
                        if (err.name === "AbortError") {
                            return;
                        }
                        console.error(err);
                    }



                });             

             
           });




          function addAllButton() {
               var table = $('#projectTable').DataTable();
            var rowCount = table.rows().count();

            // No data
            if (rowCount === 0) {
                $('#projectTable_wrapper #btnShowAll').remove();
                $('#projectTable_wrapper .dt-paging').hide();
                $('#projectTable_wrapper .dt-info').hide();
                return;
            }

            // Has data
            $('#projectTable_wrapper .dt-paging').show();
            $('#projectTable_wrapper .dt-info').show();


                    if ($('#btnShowAll').length === 0) {
                        $('.dt-paging ul').append(`
                            <li class="dt-paging-button page-item">
                                <button id="btnShowAll"
                                        class="page-link"
                                        type="button">
                                    ALL
                                </button>
                            </li>`
                        );
                    }
                }

    </script>
}







