@model WEB_TENNIC.Models.ViewModels.ProjectDetailViewModel
<div class="row gx-2" >
    <!-- Progress Input -->
    <div class="col-lg-8 mb-2">
        <div class="card shadow-sm table-card">
            <div class="card-header  d-flex justify-content-between align-items-center fw-semibold ">
                <div class="fw-semibold">
                    <i class="fas fa-table me-2"></i>
                    Progress Input
                </div>

                <div>
                    <div class="form-check">
                        <input asp-for="EndFlag" class="form-check-input border-2 border-dark " />
                        <label asp-for="EndFlag" class="form-check-label fw-semibold">
                            終了
                        </label>
                    </div>
                </div>

            </div>
            <div class="card-body">
                <div class="table-responsive h-100 table-scroll">
                    <table id="progressTable"
                           class="table table-sm table-hover table-bordered table-striped  align-middle mb-0">
                        <thead class="table-success">
                            <tr>
                                <th class="text-center">
                                    No.
                                </th>
                                <th>
                                    得意先名
                                </th>
                                <th class="text-end ">
                                    数字
                                </th>
                                <th class="text-center">
                                    アクティブ
                                </th>
                                <th>
                                    備考
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.ProjectProgress.Count; i++)
                            {
                                <tr>
                                    <td class="text-center fw-semibold">


                                        <input type="hidden"
                                               class="customerCD"
                                               asp-for="ProjectProgress[i].CustomerCD" />
                                        <input type="hidden"
                                               class="staffCD"
                                               asp-for="ProjectProgress[i].StaffCD" />
                                        @(i + 1)
                                    </td>
                                    <td>
                                        <input type="hidden"
                                               class="shopName"
                                               asp-for="ProjectProgress[i].ShopName" />
                                        <span>

                                            @Model.ProjectProgress[i].ShopName
                                        </span>
                                    </td>
                                    <td class="text-end" data-order="@Model.ProjectProgress[i].Amount">
                                        <input type="hidden"
                                               class="amount"
                                               asp-for="ProjectProgress[i].Amount" />
                                       
                                        @(Model.ProjectProgress[i].Amount?.ToString("N0")) 
                                    </td>
                                    <td class="text-center">
                                        <input   asp-for="ProjectProgress[i].Active"
                                               class="form-check-input active"
                                               />
                                    </td>
                                    <td >
                                        <input asp-for="ProjectProgress[i].Remark" 
                                               class="form-control form-control-sm remark"
                                               maxlength="150"
                                               autocomplete="off"
                                               />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
          @*   <!-- End Flag -->
            <div class="card-body py-2 px-2 border-top">
                <input asp-for="EndFlag"
                       class="btn-check" />
                <label id="endFlagLabel"
                       class="btn btn-outline-success btn-sm"
                       for="EndFlag">
                    <i id="endFlagIcon"
                       class="far fa-square me-1"></i>
                    終了
                </label>
            </div> *@
            <!-- Footer -->
            <div class="card-footer bg-light border-0 text-center">
               
                <button id="btnCancel" type="button"
                        class="btn btn-outline-secondary px-4 ms-3">
                    クリア
                </button>
                <button id="btnSave"
                        type="button"
                        class="btn btn-success  px-4 ms-3 ">
                    @* <i class="fas fa-save me-1"></i> *@
                    登録
                </button>
            </div>
        </div>
    </div>

    <!-- Summary -->
    <div class="col-lg-4">
        <div class="card shadow-sm   table-card">
            <div class="card-header fw-semibold">
                <i class="fas fa-chart-bar me-2"></i>
                Summary
            </div>
            <div class="card-body ">
                <div class="table-responsive">
                    <table id="summaryTable"
                           class="table table-sm table-hover table-bordered table-striped align-middle mb-0 ">
                        <thead class="table-info">
                            <tr>
                                <th>
                                    スタッフ名
                                </th>
                                <th>
                                    All Shop
                                </th>
                                <th>
                                    ◯ Shop
                                </th>
                                <th >
                                    ◯ ❨%❩
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.SummaryList)
                            {
                                <tr>
                                    <td>

                                        @item.StaffName

                                    </td>
                                    <td >

                                        @item.AllShop

                                    </td>
                                    <td>

                                        @item.Shop

                                    </td>
                                    <td >
                                        @(item.Percentage?.ToString("0.##") ?? "0") %
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>