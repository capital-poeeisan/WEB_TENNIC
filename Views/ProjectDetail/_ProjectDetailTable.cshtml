@model WEB_TENNIC.Models.ViewModels.ProjectDetailViewModel
<div class="row gx-2" >
    <!-- Progress Input -->
    <div class="col-lg-8 mb-2">
        <div class="card shadow-sm table-card">
            <div class="card-header  d-flex justify-content-between align-items-center fw-semibold ">
                <div class="fw-semibold">
                    <i class="fas fa-table me-2"></i>
                    Progress Input
                </div>

                <div>
                    <div class="form-check">
                        <input asp-for="EndFlag" class="form-check-input border-2 border-dark " />
                        <label asp-for="EndFlag" class="form-check-label fw-semibold">
                            終了
                        </label>
                    </div>
                </div>

            </div>
            <div class="card-body   progress-card @(Model.ProjectProgress?.Any() == true ? "has-data" : "")" >
                <div class="table-responsive  table-scroll">
                    <table id="progressTable"
                           class="table table-sm table-hover table-bordered table-striped  align-middle mb-0">
                        <thead class="table-success">
                            <tr>
                                <th class="text-center">
                                    No.
                                </th>
                                <th>
                                    得意先名
                                </th>
                                <th class="text-end ">
                                    数字
                                </th>
                                <th class="text-center">
                                    アクティブ
                                </th>
                                <th>
                                    備考
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int no = 1;
                            }

                            @foreach (var item in Model.ProjectProgress)
                            {
                                <tr>
                                    <td class="text-center fw-semibold">

                                        <input type="hidden"
                                               class="customerCD"
                                               name="ProjectProgress[@(no - 1)].CustomerCD"
                                               value="@item.CustomerCD" />

                                        <input type="hidden"
                                               class="staffCD"
                                               name="ProjectProgress[@(no - 1)].StaffCD"
                                               value="@item.StaffCD" />

                                        @no
                                    </td>

                                    <td>
                                        <input type="hidden"
                                               class="shopName"
                                               name="ProjectProgress[@(no - 1)].ShopName"
                                               value="@item.ShopName" />

                                        <span>
                                            @item.ShopName
                                        </span>
                                    </td>

                                    <td class="text-end"
                                        data-order="@item.Amount">

                                        <input type="hidden"
                                               class="amount"
                                               name="ProjectProgress[@(no - 1)].Amount"
                                               value="@item.Amount" />

                                        @(item.Amount?.ToString("N0"))
                                    </td>

                                    <td class="text-center">
                                        <input type="checkbox"
                                               class="form-check-input active"
                                               name="ProjectProgress[@(no - 1)].Active"
                                               value="true"
                                               @(item.Active ? "checked" : "") />
                                    </td>

                                    <td>
                                        <input type="text"
                                               class="form-control form-control-sm remark"
                                               name="ProjectProgress[@(no - 1)].Remark"
                                               value="@item.Remark"
                                               maxlength="150"
                                               autocomplete="off" />
                                    </td>
                                </tr>

                                no++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Footer -->
            <div class="card-footer bg-light border-0 text-center">
                 <a asp-controller="ProjectList"
                   asp-action="Index"
                     class="btn btn-outline-secondary px-4" >
                    戻る
                </a >　 
                <button id="btnSave"
                        type="button"
                        class="btn btn-success  px-4">
                   
                    登録
                </button>
            </div>
        </div>
    </div>

    <!-- Summary -->
    <div class="col-lg-4">
        <div class="card shadow-sm   table-card mb-2 summary-card @(Model.SummaryList?.Any() == true ? "has-data" : "")">
            <div class="card-header fw-semibold">
                <i class="fas fa-chart-bar me-2"></i>
                Summary
            </div>
            <div class="card-body">
                <div class="table-responsive table-scroll">
                    <table id="summaryTable"
                           class="table table-sm table-hover table-bordered table-striped align-middle mb-0 ">
                        <thead class="table-info">
                            <tr>
                                <th>
                                    スタッフ名
                                </th>
                                <th>
                                    All Shop
                                </th>
                                <th>
                                    ◯ Shop
                                </th>
                                <th >
                                    ◯ ❨%❩
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.SummaryList)
                            {
                                <tr>
                                    <td>

                                        @item.StaffName

                                    </td>
                                    <td >

                                        @item.AllShop

                                    </td>
                                    <td>

                                        @item.Shop

                                    </td>
                                    <td >
                                        @(item.Percentage?.ToString("0.##") ?? "0") %
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div> 
        @if (Model.SummaryList?.Any(x => x.Shop > 0) == true)
{
            <div class="card shadow-sm pie-card">


                <div class="card-body pie-card-body">


                    <div class="chart-container">
                        <canvas id="staffPieChart"></canvas>
                    </div>


                </div>
            </div>
}
       
    </div>
</div>