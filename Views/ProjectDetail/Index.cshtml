@model WEB_TENNIC.Models.ViewModels.ProjectDetailViewModel
<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-3 ">

    <h3 class="mb-0 fw-bold textcolor-custom">
        <i class="fas fa-chart-line me-2"></i>
        結果を登録する
    </h3>
</div>
<!-- Search Card -->

<form id="detailform" asp-action="Index" method="post">
    <!-- Project -->
    <div class="row mb-2 g-1 align-items-center">
        <label asp-for="ProjectCd"
               class="col-custom col-form-label fw-semibold text-start">
            プロジェクト名
        </label>
        <div class="col-md-5 ">
            <select asp-for="ProjectCd"
                    asp-items="Model.ProjectList"
                    class="form-select select2-single"
                    disabled="@(Model.IsProjectLocked)">
                <option value="">
                    Select Project
                </option>
            </select >
            @if (Model.IsProjectLocked)
            {
                <input type="hidden" asp-for="ProjectCd" />
            }
            <input type="hidden" id="OriginalEndFlag"
                   value="@Model.EndFlag.ToString().ToLower()" />
            <input type="hidden"
                   id="ProjectCdLock"
                   value="@Model.IsProjectLocked.ToString().ToLower()" />
        </div>
    </div>
    <!-- Staff -->
    <div class="row mb-2 g-1 align-items-center">
        <label asp-for="StaffCD"
               class="col-custom col-form-label fw-semibold  text-start">
            スタッフ名
        </label>
        <div class="col-md-7">
            <select asp-for="StaffCD"
                    asp-items="Model.StaffList"
                    class="form-select select2-multiple fw-semibold"
                    multiple="multiple">

                <option value="">
                    Select Staff
                </option>
            </select>
        </div>
        <div class="col-md-3 mt-2 mt-md-0">
            <button class="btn btn-primary shadow-sm px-4 "
                    id="btnShow"
                    type="button">
                表示
            </button>
        </div>
    </div>

</form>
<div id="tableArea">
    <partial name="_ProjectDetailTable" />
</div>
@section Scripts {
    <script>
        let isInitialLoad= true;
        $(document).ready(function(){

            $('#ProjectCd').select2({
            width: '100%',
             placeholder:"Select Project",

        });

            $('#StaffCD').select2({
            width: '100%',
                     placeholder:"スタッフを選択してください",
            closeOnSelect: false
        });
            initializeDataTables();

            $("#ProjectCd").change(function(){
                var projectCd=$(this).val();
                 var staff = $("#StaffCD");
                  staff.val(null).trigger("change");
                staff.empty();
                if(!projectCd)
                {
                  $('#progressTable').DataTable().clear().draw();
                      $('#summaryTable').DataTable().clear().draw();

                        return;
                }
                $.get('@Url.Action("GetStaff", "ProjectDetail")',
                {
                    projectCd:projectCd
                },
                function(staffList){
                    var staff=$("#StaffCD");
                    staff.empty();

                    $.each(staffList,function(i,item){
                        staff.append(
                            $("<option>",{
                                value:item.value,
                                text:item.text
                            })
                        );
                    });
                    staff.trigger("change");
                    $('#progressTable').DataTable().clear().draw();
                    $('#summaryTable').DataTable().clear().draw();
                            $('.pie-card').addClass('d-none');
                      if (isInitialLoad) {
                $("#btnShow").click();
            }

            isInitialLoad = false;
                });
            }); 

            $("#btnShow").click(function(){ 

                 var projectCd = $("#ProjectCd").val();

                 // If ProjectCd is disabled, get it from hidden input
                 if (!projectCd) {
                     projectCd = $("input[name='ProjectCd']").val();
                 }
                 var currentEndFlag = $("#EndFlag").is(":checked");
                $.ajax({
                    url: '@Url.Action("GetData", "ProjectDetail")',
                    type:"POST",
                   data: {
            ProjectCd: projectCd,
            StaffCD: $("#StaffCD").val(),
            EndFlag: currentEndFlag
        },
                    success:function(result){
                        if(result.success===false){
                            Swal.fire({
                                 title:"警告！",
                                   html:"プロジェクト名を選択してください。",
                               confirmButtonText: 'はい',
                               width: '360px',
                               customClass: {
                                   popup: 'my-popup',
                                    title: 'title-warting',
                                     confirmButton: 'warning-btn'
                               },
                 buttonsStyling: false
                            });
                            return;

                        }
                        $("#tableArea").html(result);
                         $("#EndFlag").prop("checked", currentEndFlag);
                               
                         setProgressReadonly();
                        initializeDataTables();
                        initializeStaffPieChart();
                    }
                });
            });
        
        $(document).on("click", "#btnSave", function () {
        if (!$("#ProjectCd").val()) {
            Swal.fire({
                title: "警告！",
                html: "プロジェクト名を選択してください。",
                confirmButtonText: "はい",
                         width: '360px',
                    customClass: {
                        popup: 'my-popup',
                        title: 'title-warting',
                        confirmButton: 'warning-btn'
                                      },
                        buttonsStyling: false
            });
            return;
        }

 
         if ($("#progressTable").DataTable().rows().count() === 0) {
            Swal.fire({
                 title:"警告！",
                html: "データがありません。",
                 confirmButtonText: 'はい',
                              width: '360px',
                              customClass: {
                                  popup: 'my-popup',
                                   title: 'title-warting',
                                    confirmButton: 'warning-btn'
                              },
                buttonsStyling: false
            });
            return;
        } 

        var hasChecked = $("#progressTable .active:checked").length > 0;
         var endFlgChecked = $("#EndFlag").is(":checked"); 
          var message = "";

         if (!hasChecked && !endFlgChecked) {
              message = "どの行も選択されていません.登録しますか？";
        }
        else if (hasChecked && endFlgChecked) {

            message = "終了 して、登録されますか？";

        }
        else if (!hasChecked && endFlgChecked) {
            message = "どの行も チェック　しないで、終了　しますか？";

        }

       
        else
        {
            message ="登録しますか？";
        }
        Swal.fire({
                     title: "確認？",
                 // icon: "question",
                 showCancelButton: true,
                 confirmButtonText: "登録",
                 cancelButtonText: "キャンセル",
                   html: message,
                  confirmButtonText: 'はい',
                               width: '360px',
                               customClass: {
                                     popup: 'my-popup',
                                     title: 'title-question',
                                       confirmButton: 'confirm-btn',
                                        cancelButton:'cancecl-btn'
                               },
                 buttonsStyling: false
            }).then((result) => {

                if (result.isConfirmed) {
                    saveProject();
                }
            });
        });

            $(document).on("keydown", ".remark", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();

                var remarks = $("#progressTable .remark");
                var index = remarks.index(this);

                if (index < remarks.length - 1) {
                    remarks.eq(index + 1).focus().select();
                } else {
                    $("#btnSave").focus();
                }
            }
        });

          $(document).on("change", "#EndFlag", function () {

             setProgressReadonly();
        });

                var projectCd = $("#ProjectCd").val();
                    if (projectCd) {
                        $("#ProjectCd").trigger("change");
                       

                    }

     });
        
        function addShowAllButton() {

            var table = $('#progressTable').DataTable();
            var rowCount = table.rows().count();

            // No data
            if (rowCount === 0) {
                $('#progressTable_wrapper #btnShowAll').remove();
                $('#progressTable_wrapper .dt-paging').hide();
                $('#progressTable_wrapper .dt-info').hide();
                return;
            }

            // Has data
            $('#progressTable_wrapper .dt-paging').show();
            $('#progressTable_wrapper .dt-info').show();

            if ($('#progressTable_wrapper #btnShowAll').length === 0) {

                $('#progressTable_wrapper .dt-paging ul').append(`
                    <li class="dt-paging-button page-item">
                        <button id="btnShowAll"
                                type="button"
                                class="page-link">
                            ALL
                        </button>
                    </li>
                `);
            }
        }
        
            
        function initializeDataTables() {
            // Destroy old Progress DataTable
            if ($.fn.DataTable.isDataTable('#progressTable')) {
                $('#progressTable').DataTable().destroy();
            }
            // Initialize Progress Table
            var progressTable = $('#progressTable').DataTable({
                paging: true,
                searching: false,
                ordering: true,
                info: true,
                pageLength: 15,
                lengthChange: true,
                responsive: true,
                autoWidth: false,
                layout: {
                    topStart: null
                },
                order: [],
                columnDefs: [
                    {
                        targets: 0,   // No column
                        orderable: false
                    }
                ],
                initComplete: function () {
                 $("#progressTable tbody .remark:first").focus();
                }
            });
            // Destroy old Summary DataTable
            if ($.fn.DataTable.isDataTable('#summaryTable')) {
                $('#summaryTable').DataTable().destroy();
            }
            // Initialize Summary Table
            $('#summaryTable').DataTable({
                paging: false,
                searching: false,
                ordering: false,
                info: false,
                autoWidth: false,
                layout: {
                    topStart: null
                }
            });

          addShowAllButton();
        progressTable.on('draw', function () {
            addShowAllButton();});
                    $(document)
                    .off('click','#btnShowAll')
                    .on('click','#btnShowAll',function(){
                     $('#progressTable')
                         .DataTable()
                         .page
                         .len(-1)
                         .draw();
                          $('.dt-paging-button').removeClass('current active');
                          $('#btnShowAll').addClass("dt-paging-button page-item active");
                        });
        }

        function saveProject() {

            var data={
                    ProjectCd:$("#ProjectCd").val(),
                    StaffCD:$("#StaffCD").val(),
                    EndFlag:$("#EndFlag").is(":checked"),
                    ProjectProgress:[]
                };
       var table = $('#progressTable').DataTable();
        data.ProjectProgress = [];

        table.rows().every(function () {
            var row = $(this.node());

            data.ProjectProgress.push({
                CustomerCD: row.find(".customerCD").val(),
                StaffCD: row.find(".staffCD").val(),
                ShopName: row.find(".shopName").val(),
                Amount: row.find(".amount").val(),
                Active: row.find(".active").prop("checked"),
                Remark: row.find(".remark").val()
            });
        });
            $.ajax({
                url: '@Url.Action("Save", "ProjectDetail")',
                type: "POST",
                data: JSON.stringify(data),
                contentType: "application/json",
                success: function () {

                    Swal.fire({
                         title: '成功!',
                        html: "登録しました。",
                      confirmButtonText: "はい",
                             width: '360px',
                             customClass: {
                                 popup: 'my-popup',
                                 title: 'my-title-success',
                                 confirmButton: 'success-btn'
                             },
                             buttonsStyling: false
                                }).then(() => {
                                    location.reload();
                              });

                },
                error: function () {

                    Swal.fire({
                        title: "エラー",
                        text: "登録に失敗しました。",
                           confirmButtonText: 'はい',
                                 width: '360px',
                                 customClass: {
                                     popup: 'my-popup',
                                     title: 'my-title',
                                     confirmButton: 'my-button'
                                 },
                                 buttonsStyling: false
                    });
                }
            });
        }

         function setProgressReadonly() {

            var isLockedProject = $("#ProjectCdLock").val() === "true";
            var originalEndFlag = $("#OriginalEndFlag").val() === "true";
            var currentEndFlag = $("#EndFlag").is(":checked");


            if (!isLockedProject) {
                return;
            }
                    var readonly = isLockedProject && originalEndFlag && currentEndFlag;

            
;            $("#progressTable input").each(function () {

                if ($(this).hasClass("active")) {

                    $(this).prop("disabled", readonly);

                } else {

                    $(this).prop("readonly", readonly);

                }

            });
        }


         Chart.register(ChartDataLabels);

        function initializeStaffPieChart() {

            const canvas = document.getElementById("staffPieChart");

            if (!canvas) return;

            // Destroy existing chart
            const existingChart = Chart.getChart(canvas);

            if (existingChart) {
                existingChart.destroy();
            }

                   let labels = [];
        let data = [];

        $("#summaryTable tbody tr").each(function () {

            let staffName = $(this)
                .find("td:eq(0)")
                .text()
                .trim();

            let percentage = parseFloat(
                $(this)
                    .find("td:eq(3)")
                    .text()
                    .trim()
                    .replace("%", "")
            ) || 0;

            if (percentage > 0) {

                labels.push(staffName);
                data.push(percentage);
            }
        });


            // No data
            if (data.length === 0) {
                return;
            }
            $('.pie-card').removeClass('d-none');

            // Create Pie Chart
            new Chart(canvas, {

                type: 'pie',

                data: {

                    labels: labels,

                    datasets: [{

                        data: data,

                        borderWidth: 1
                    }]
                },


                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    layout: {
                        padding: 5
                    },


                    plugins: {

                        // Hide normal legend
                        legend: {
                            display: false
                        },


                        // =========================
                        // Staff Names Inside Pie
                        // =========================

                        datalabels: {

                            display: true,

                            color: '#ffffff',

                            anchor: 'center',

                            align: 'center',

                            clamp: true,

                            clip: false,

                            textAlign: 'center',


                            // Rotate label according to
                            // direction of pie slice
                            rotation: function (context) {

                                const chart = context.chart;

                                const index = context.dataIndex;

                                const meta =
                                    chart.getDatasetMeta(0);

                                const arc =
                                    meta.data[index];

                                if (!arc) {
                                    return 0;
                                }


                                // Middle angle of this slice
                                let angle =
                                    (arc.startAngle +
                                        arc.endAngle) / 2;


                                // Convert radians to degrees
                                let degrees =
                                    angle * 180 / Math.PI;


                                // Keep text upright
                                if (degrees > 90) {
                                    degrees -= 180;
                                }

                                if (degrees < -90) {
                                    degrees += 180;
                                }


                                return degrees;
                            },


                            
                            font: function (context) {

                                const chart = context.chart;

                                const index =
                                    context.dataIndex;

                                const meta =
                                    chart.getDatasetMeta(0);

                                const arc =
                                    meta.data[index];


                                if (!arc) {

                                    return {
                                        size: 13,
                                        weight: 'bold'
                                    };
                                }


                                const angle =
                                    arc.endAngle -
                                    arc.startAngle;


                                const degrees =
                                    angle * 180 / Math.PI;


                                let size = 13;


                                if (degrees < 35) {

                                    size = 11;

                                }
                                else if (degrees < 50) {

                                    size = 12;

                                }
                                else {

                                    size = 13;
                                }


                                return {

                                    size: size,

                                    weight: 'bold'
                                };
                            },


                            

                            formatter: function (value, context) {

                                let name =
                                    context.chart.data.labels[
                                        context.dataIndex
                                    ];


                                name = name.trim();


                                // Short name
                                if (name.length <= 7) {
                                    return name;
                                }


                                // Medium name
                                if (name.length <= 14) {

                                    const middle =
                                        Math.ceil(name.length / 2);


                                    return [
                                        name.substring(0, middle),
                                        name.substring(middle)
                                    ];
                                }


                                // Long name
                                return [
                                    name.substring(0, 7),
                                    name.substring(7)
                                ];
                            }
                        },


                        // =========================
                        // Tooltip
                        // =========================

                               tooltip: {

            callbacks: {

                label: function (context) {

                    const value = context.raw;

                    return context.label +
                        ": " +
                        value.toFixed(1) +
                        "%";
                }
            }
        }
                    }
                }
            });
        }
    </script>
}