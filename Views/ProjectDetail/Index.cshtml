        function initializeDataTables() {

            // Destroy old Progress DataTable
            if ($.fn.DataTable.isDataTable('#progressTable')) {
                $('#progressTable').DataTable().destroy();
            }

            // Initialize Progress Table
            var progressTable = $('#progressTable').DataTable({
                paging: true,
                searching: false,
                ordering: true,
                info: true,
                pageLength: 15,
                lengthChange: true,
                responsive: false,
                autoWidth: false,

                layout: {
                    topStart: null
                },

                // Default: no initial sorting
                order: [],

                columnDefs: [
                    {
                        // No. column
                        targets: 0,
                        orderable: false
                    },
                    {
                        // 対応済 checkbox column
                        targets: 3,
                        type: 'num',

                        render: function (data, type, row, meta) {

                            if (type === 'sort') {
                                var checkbox = $(meta.settings.aoData[meta.row].nTr)
                                    .find('.active');

                                return checkbox.prop('checked') ? 1 : 0;
                            }

                            return data;
                        }
                    },
                         {
            targets: 4,
            type: 'num',

            render: function (data, type, row, meta) {

                if (type === 'sort') {

                    var value = $(meta.settings.aoData[meta.row].nTr)
                        .find('.resultamt')
                        .val();

                    return parseInt(
                        (value || '').replace(/,/g, ''),
                        10
                    ) || 0;
                }

                return data;
            }
        },
                   {
