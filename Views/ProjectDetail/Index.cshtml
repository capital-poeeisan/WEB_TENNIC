                       $(document).on('keydown', '#progressTable input', function (e) {

            if (e.key !== 'Enter') {
                return;
            }

            e.preventDefault();

            // Format ResultAmt when pressing Enter
            if ($(this).hasClass('resultamt')) {

                let value = this.value.replace(/,/g, '');

                if (value) {
                    this.value = Number(value).toLocaleString('en-US');
                }
            }

            const editableInputs = $('#progressTable')
                .find('input.active, input.resultamt, input.remark')
                .filter(':visible:not(:disabled)');

            const currentIndex = editableInputs.index(this);

            if (currentIndex === -1) {
                return;
            }

            const nextInput = editableInputs.eq(currentIndex + 1);

            if (nextInput.length) {
                nextInput.focus();
                nextInput[0].select();
            }
        });
     
        
     $.fn.dataTable.ext.order['dom-remark'] = function (settings, col) {

            return this.api()
                .column(col, { order: 'index' })
                .nodes()
                .map(function (td) {
                    return $('.remark', td).val()?.trim() || '';
                });
        };
       
      const remarkCollator = new Intl.Collator('ja-JP', {
            numeric: true,
            sensitivity: 'base'
        });

        $.fn.dataTable.ext.type.order['remark-natural-asc'] = function (a, b) {

            a = (a ?? '').toString().trim();
            b = (b ?? '').toString().trim();

            
            if (a === '' && b === '') return 0;
            if (a === '') return 1;
            if (b === '') return -1;

            return remarkCollator.compare(a, b);
        };

        $.fn.dataTable.ext.type.order['remark-natural-desc'] = function (a, b) {

            a = (a ?? '').toString().trim();
            b = (b ?? '').toString().trim();

           
            if (a === '' && b === '') return 0;
            if (a === '') return 1;
            if (b === '') return -1;

            return remarkCollator.compare(b, a);
        }; 

