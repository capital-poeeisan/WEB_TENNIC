            var originalEndFlag = $("#OriginalEndFlag").val() === "true";
            var currentEndFlag = $("#EndFlag").is(":checked");


            if (!isLockedProject) {
                return;
            }
                    var readonly = isLockedProject && originalEndFlag && currentEndFlag;

            
;            $("#progressTable input").each(function () {

                if ($(this).hasClass("active")) {

                    $(this).prop("disabled", readonly);

                } else {

                    $(this).prop("readonly", readonly);

                }

            });
        }


         Chart.register(ChartDataLabels);

        function initializeStaffPieChart() {

            const canvas = document.getElementById("staffPieChart");

            if (!canvas) return;

            // Destroy existing chart
            const existingChart = Chart.getChart(canvas);

            if (existingChart) {
                existingChart.destroy();
            }

                   let labels = [];
        let data = [];

        $("#summaryTable tbody tr").each(function () {

            let staffName = $(this)
                .find("td:eq(0)")
                .text()
                .trim();

          if (staffName === "合　計" || staffName === "合計") {
                return;
            }

            let percentage = parseFloat(
                $(this)
                    .find("td:eq(3)")
                    .text()
                    .trim()
                    .replace("%", "")
            ) || 0;

            if (percentage > 0) {

                labels.push(staffName);
                data.push(percentage);
            }
        });


            // No data
            if (data.length === 0) {
                return;
            }
            $('.pie-card').removeClass('d-none');

            // Create Pie Chart
            new Chart(canvas, {

                type: 'pie',

                data: {

                    labels: labels,

                    datasets: [{

                        data: data,

                        borderWidth: 1
                    }]
                },


                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    layout: {
                        padding: 5
                    },


                    plugins: {

                        // Hide normal legend
                        legend: {
                            display: false
                        },


                        // =========================
                        // Staff Names Inside Pie
                        // =========================

                        datalabels: {

                            display: true,

                            color: '#ffffff',

                            anchor: 'center',

                            align: 'center',

                            clamp: true,

                            clip: false,

                            textAlign: 'center',


                            // Rotate label according to
                            // direction of pie slice
                            rotation: function (context) {

                                const chart = context.chart;

                                const index = context.dataIndex;

                                const meta =
                                    chart.getDatasetMeta(0);

                                const arc =
                                    meta.data[index];

                                if (!arc) {
                                    return 0;
                                }


                                // Middle angle of this slice
                                let angle =
                                    (arc.startAngle +
                                        arc.endAngle) / 2;


                                // Convert radians to degrees
                                let degrees =
                                    angle * 180 / Math.PI;


                                // Keep text upright
                                if (degrees > 90) {
                                    degrees -= 180;
                                }

                                if (degrees < -90) {
                                    degrees += 180;
                                }


                                return degrees;
                            },


                            
                            font: function (context) {

                                const chart = context.chart;

                                const index =
                                    context.dataIndex;

                                const meta =
                                    chart.getDatasetMeta(0);

                                const arc =
                                    meta.data[index];


                                if (!arc) {

                                    return {
                                        size: 13,
                                        weight: 'bold'
                                    };
                                }


                                const angle =
                                    arc.endAngle -
                                    arc.startAngle;


                                const degrees =
                                    angle * 180 / Math.PI;


                                let size = 13;


                                if (degrees < 35) {

                                    size = 11;

                                }
                                else if (degrees < 50) {

                                    size = 12;

                                }
                                else {

                                    size = 13;
                                }


                                return {

                                    size: size,

                                    weight: 'bold'
                                };
                            },


                            

                            formatter: function (value, context) {

                                let name =
                                    context.chart.data.labels[
                                        context.dataIndex
                                    ];


                                name = name.trim();


                                // Short name
                                if (name.length <= 7) {
                                    return name;
                                }


                                // Medium name
                                if (name.length <= 14) {

                                    const middle =
                                        Math.ceil(name.length / 2);


                                    return [
                                        name.substring(0, middle),
                                        name.substring(middle)
                                    ];
                                }


                                // Long name
                                return [
                                    name.substring(0, 7),
                                    name.substring(7)
                                ];
                            }
                        },


                        // =========================
                        // Tooltip
                        // =========================

                               tooltip: {

            callbacks: {

                label: function (context) {

                    const value = context.raw;

                    return context.label +
                        ": " +
                        value.toFixed(1) +
                        "%";
                }
            }
        }
                    }
                }
            });
        }

       function enableColumnResize1(tableId) {

            const table = document.getElementById(tableId);

            if (!table) return;

            const headers = table.querySelectorAll("thead th");

            headers.forEach(function (th) {

              
                if (th.querySelector(".column-resizer")) return;

                const resizer = document.createElement("div");

                resizer.className = "column-resizer";

                th.appendChild(resizer);

                let startX;
                let startWidth;

                resizer.addEventListener("mousedown", function (e) {

                    e.preventDefault();
                    e.stopPropagation();

                    startX = e.pageX;
                    startWidth = th.offsetWidth;

                    document.body.classList.add("resizing");

                    function mouseMove(e) {

                        const newWidth =
                            startWidth + (e.pageX - startX);

                        if (newWidth >= 50) {
                            th.style.width = newWidth + "px";
                        }
                    }

                    function mouseUp() {

                        document.removeEventListener(
                            "mousemove",
                            mouseMove
                        );

                        document.removeEventListener(
                            "mouseup",
                            mouseUp
                        );

                        document.body.classList.remove("resizing");
                    }

                    document.addEventListener(
                        "mousemove",
                        mouseMove
                    );

                    document.addEventListener(
                        "mouseup",
                        mouseUp
                    );
                });
            });
        }


       function enableColumnResize(tableId) {

            const table = document.getElementById(tableId);

            if (!table) return;

            const headers = table.querySelectorAll("thead th");

            headers.forEach(function (th) {

                
                if (th.querySelector(".column-resizer")) return;

                
                th.style.position = "relative";

                const resizer = document.createElement("div");
                resizer.className = "column-resizer";

                th.appendChild(resizer);

                let startX = 0;
                let startWidth = 0;
                let currentWidth = 0;
                let animationFrame = null;

                resizer.addEventListener("mousedown", function (e) {

                    e.preventDefault();
                    e.stopPropagation();

                    startX = e.pageX;
                    startWidth = th.getBoundingClientRect().width;

                    document.body.classList.add("resizing");

                    function mouseMove(e) {

                        const diff = e.pageX - startX;

                        let newWidth = startWidth + diff;

                        
                        newWidth = Math.max(50, newWidth);

                        currentWidth = newWidth;

                       
                        if (!animationFrame) {

                            animationFrame = requestAnimationFrame(function () {

                                th.style.width = currentWidth + "px";
                                th.style.minWidth = currentWidth + "px";

                                animationFrame = null;
                            });
                        }
                    }

                    function mouseUp() {

                        if (animationFrame) {
                            cancelAnimationFrame(animationFrame);
                            animationFrame = null;
                        }

                        document.removeEventListener("mousemove", mouseMove);
                        document.removeEventListener("mouseup", mouseUp);

                        document.body.classList.remove("resizing");
                    }

                    document.addEventListener("mousemove", mouseMove);
                    document.addEventListener("mouseup", mouseUp);
                });
            });
        }
      
       </script>
