@model WEB_TENNIC.Models.ViewModels.ImportExcelViewModel
<link href="~/css/bootstrap.min.css" rel="stylesheet" />
<script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">

    <h3 class="mb-0 text-primary fw-semibold" id="pg-header">
        <i class="fas fa-file-excel me-2"></i>
        Excel Import
    </h3>

</div>

<div class="card shadow  py-2 px-1">
    <div class="card-body " style="padding-top:0px!important;">

        <div class="card-body">
            <div class="row justify-content-center">
                <div class="col-lg-7 col-md-9">

                    <!-- Project Name -->
                    <div class="row-cols-1">
                        <label class="col-md-3 col-form-label fw-semibold">
                            プロジェクト名
                        </label>

                        <input type="text" asp-for="ProjectName"
                        autofocus
                               class="col-md-6 form-control"
                               id="ProjectName"
                               name="ProjectName"
                               maxlength="50">

                    </div>
                

                    <!-- Excel File -->
                    <div class="row-cols-1">
                        <label class="col-md-3 col-form-label fw-semibold">
                            Excelファイル
                        </label>

                        <div class="input-group col-md-6">

                            <input type="text"
                                  
                                   id="fileName"
                                   class="form-control"
                                   placeholder="Excelファイルを選択してください。"
                                   readonly>

                            <button class="btn btn-light border"
                                    type="button"
                                    id="browseBtn"
                                    onclick="document.getElementById('excelFile').click()">
                                <i class="bi bi-three-dots" style="font:bold;font-size:large;align-items:center;">...</i>
                            </button>


                        </div>


                        <span id="fileNameError" class="text-danger"></span>
                        <input type="file"
                               id="excelFile"
                               accept=".xlsx,.xls"
                               name="fileName"
                               hidden
                               onchange="checkExcelFile(this)">
                    </div>
                    <div class="d-flex justify-content-center gap-3 mt-3">
                        <div class="card-footer bg-light border-0 text-center">
                            <a class="btn btn-outline-secondary px-4 fw-semibold" href="@Url.Action("Index", "ProjectList")">
                                戻る
                            </a>
                            <button id="btnSave" type="button" class="btn btn-success  px-4 fw-semibold ">
                                登録
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
        function checkExcelFile(input) {

        if (input.files.length === 0)
            return;
        var file = input.files[0];
        var fileName = file.name;
        var extension = fileName.split('.').pop().toLowerCase();

        if (extension !== "xlsx" && extension !== "xls") {
                            Swal.fire({
                            title: 'エラー!',
                            html: 'Excelファイルを選択してください。',
                            confirmButtonText: 'はい',
                            width: '360px',
                            customClass: {
                                popup: 'my-popup',
                                title: 'my-title',
                                confirmButton: 'my-button'
                            },
                            buttonsStyling: false
                        });


            input.value = "";
            document.getElementById("fileName").value = "";
            return;
        }

        document.getElementById("fileName").value = fileName;
    }



        $("#btnSave").click(function () {
            var file = $("#excelFile")[0].files[0];
             var projectName = $("#ProjectName").val().trim();

            if (projectName === "") {

              document.activeElement?.blur();
               Swal.fire({
                 title:"警告！",
                 html:"プロジェクト名を選択してください。",
                 confirmButtonText: 'はい',
                 width: '360px',
                 customClass: {
                     popup: 'my-popup',
                      title: 'title-warting',
                       confirmButton: 'warning-btn'
                 },
               buttonsStyling: false }).then(() => {
               $("#ProjectName").focus();});
                               return;
                }

            if (!file) {
                             document.activeElement?.blur();
                            Swal.fire({
                                title: '警告!',
                                html: 'Excelファイルを選択してください。',
                                confirmButtonText: 'はい', width: '360px',
                                customClass: { popup: 'my-popup', title: 'title-warting', confirmButton: 'warning-btn' },
                                buttonsStyling: false }).then(() =>
                                {
                                    $("#fileName").focus();
                                });
                                return;
                            }
            var formData = new FormData();

            formData.append("ProjectName", $("#ProjectName").val());
            // formData.append("ProjectCd", $("#ProjectCd").val());
            formData.append("fileName", file);

            // alert($("#ProjectCd").val());

            $.ajax({
                
              url: '@Url.Action("UploadExcel", "ImportExcel")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,

                success: function (res) {

                    if (!res.success) {

                        Swal.fire({
                            title: 'エラー!',
                            html: res.message,
                            confirmButtonText: 'はい',
                            width: '360px',
                            customClass: {
                                        popup: 'my-popup',
                                        title: 'my-title',
                                        confirmButton: 'my-button'
                                    },buttonsStyling: false


                        });

                        return;
                    }


                     if (res.warnings && res.warnings.length > 0) {

                        Swal.fire({
                            title: '警告!',
                            html: res.warnings.join("<br><br>"),
                            confirmButtonText: 'はい',
                            width: '360px',
                            customClass: {
                                      popup: 'my-popup',
                                      title: 'title-warting',
                                      confirmButton: 'warning-btn'
                                 },buttonsStyling: false
                        })
                        .then(() => {

                            Swal.fire({
                                title: '成功!',
                                html: res.message,
                                confirmButtonText: 'はい',
                                width: '360px',
                                    customClass: {
                                        popup: 'my-popup',
                                        title: 'my-title-success',
                                        confirmButton: 'success-btn'
                                    },
                                    buttonsStyling: false
                            })
                            .then(() => {
                               
                                location.href = '@Url.Action("Index", "ProjectList")';
                            });

                        });

                    }
                    else {

                        Swal.fire({
                            title: '成功!',
                            html: res.message,
                            confirmButtonText: 'はい',
                            width: '360px',
                                    customClass: {
                                        popup: 'my-popup',
                                        title: 'my-title-success',
                                        confirmButton: 'success-btn'
                                    },
                                    buttonsStyling: false
                        })
                        .then(() => {
                            location.href = '@Url.Action("Index", "ProjectList")';
                        });

                    }

                }
            });

    });
</script>

