@model WEB_TENNIC.Models.ViewModels.ImportExcelViewModel
<link href="~/css/bootstrap.min.css" rel="stylesheet" />
<script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">

    <h3 class="mb-0 text-primary fw-bold" id="pg-header">
        <i class="fas fa-file-excel me-2"></i>
       Excel Import
    </h3>

</div>

<div class="card shadow  py-2 px-1">
    <div class="card-body " style="padding-top:0px!important;">
        @* <div class="card shadow-sm h-100 table-card"> *@

           @*  <div class="card-header fw-semibold">
                <i class="fas fa-table me-2"></i>
                Excel Import
            </div> *@
            <div class="card-body">
                <div class="row justify-content-center">
                    <div class="col-lg-7 col-md-9">
                        @if (@TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-dismissible fade show border-0 shadow-sm"
                                 role="alert"
                                 style="background:#fdeaea;color:#dc3545;">
                                <i class="bi bi-exclamation-circle-fill me-2"></i>
                                @TempData["ErrorMessage"]
                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="alert"
                                        aria-label="Close"></button>
                            </div>
                            @* <div asp-validation-summary="All" class="text-danger"></div> *@
                        }
                        @if (TempData["SuccessMessage"] != null)
                        {

                            <div class="alert alert-dismissible fade show border-0 shadow-sm"
                                 role="alert"
                                 style="background:#e8f1ff;color:#0d6efd;">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                @TempData["SuccessMessage"]
                                <button type="button"
                                        class="btn-close"
                                        data-bs-dismiss="alert"
                                        aria-label="Close"></button>
                            </div>

                        }

                        <form asp-action="UploadExcel" enctype="multipart/form-data" id="uploadForm" method="post">

                            <!-- Project Name -->
                            <div class="row-cols-1">
                                <label class="col-md-3 col-form-label fw-bold">
                                    Project Name
                                </label>
                                <input type="text" autofocus class="col-md-6 form-control" id="ProjectName" name="ProjectName" maxlength="50" required>


                            </div>

                            <!-- Excel File -->
                            <div class="row-cols-1">
                                <label class="col-md-3 col-form-label fw-bold">
                                    Excel File
                                </label>

                                <div class="input-group col-md-6">

                                    <input type="text"
                                           id="fileName"
                                           class="form-control"
                                           placeholder="Select Excel File"
                                           readonly
                                           required>

                                    <button class="btn btn-light border"
                                            type="button"
                                            id="browseBtn"
                                            onclick="document.getElementById('excelFile').click()">
                                    <i class="bi bi-three-dots" style="font:bold;font-size:large;align-items:center;">...</i>
                                    </button>

                                </div>

                                <input type="file"
                                       id="excelFile"
                                       accept=".xlsx,.xls"
                                       name="fileName"
                                       hidden
                                       onchange="checkExcelFile(this)"
                                       required>
                            </div>
                            <div class="d-flex justify-content-center gap-3 mt-3">
                                <div class="card-footer bg-light border-0 text-center">
                                    <a class="btn btn-outline-secondary px-4" href="@Url.Action("Index", "ProjectList")">                                       
                                        戻る
                                    </a>
                                    <button id="btnSave" type="submit" class="btn btn-success  px-4 ms-3 ">
                                        登録
                                    </button>
                                </div>
                            </div>
                           
                           
                        </form>


                        @if (ViewBag.Errors != null)
                        {
                            <div class="alert alert-danger">
                                <ul>
                                    @foreach (var error in ViewBag.Errors)
                                    {
                                        <li>@error</li>
                                    }
                                </ul>
                            </div>
                        }

                    </div>
                </div>
           @*  </div>     *@    
         
        </div>
       
    </div>
</div>


<script>
        function checkExcelFile(input) {

        if (input.files.length === 0)
            return;
        var file = input.files[0];
        var fileName = file.name;
        var extension = fileName.split('.').pop().toLowerCase();

        if (extension !== "xlsx" && extension !== "xls") {
            alert("Please select only Excel (.xlsx or .xls) file.");

            input.value = "";
            document.getElementById("fileName").value = "";
            return;
        }

        document.getElementById("fileName").value = fileName;
    }
</script>