@model WEB_TENNIC.Models.ViewModels.ProjectDetailViewModel


<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">

    <h3 class="mb-0 fw-bold">
        <i class="fas fa-chart-line me-2"></i>
        Project Progress Input & Summary
    </h3>

</div>


<!-- Search Card -->
<div class="card shadow pg-header  py-2 px-1">
    <div class="card-body ">
        <form id="detailform" asp-action="Index" method="post">
            <!-- Project -->
            <div class="row mb-2 gx-2 align-items-center">

                <label asp-for="ProjectCd"
                       class="col-md-2 col-form-label fw-semibold">
                    Project Name
                </label>
                <div class="col-md-6">
                    <select asp-for="ProjectCd"
                            asp-items="Model.ProjectList"
                            class="form-select">
                        <option value="">
                            Select Project
                        </option>
                    </select>
                </div>
            </div>

            <!-- Staff -->
            <div class="row mb-2 gx-2  align-items-center">
                <label asp-for="StaffCD"
                       class="col-md-2 col-form-label fw-semibold">
                    Staff Name
                </label>
                <div class="col-md-7 ">
                    <select asp-for="StaffCD"
                            asp-items="Model.StaffList"
                            class="form-select select2 fw-semibold"
                            multiple="multiple">
                        <option value="">
                            Select Staff
                        </option>
                    </select>
                </div>
                <div class="col-md-3 mt-2 mt-md-0">
                    <button class="btn btn-primary shadow-sm px-4 "
                            id="btnShow"
                            type="button">

                       @*  <i class="fas fa-search me-1"></i> *@
                        表示
                    </button>
                </div>
            </div>
        </form>
        <div id="tableArea">
            <partial name="_ProjectDetailTable" />
        </div>
    </div>
</div>
@section Scripts {
    <script>
            function initializeDataTables() {
            // Destroy old Progress DataTable
            if ($.fn.DataTable.isDataTable('#progressTable')) {
                $('#progressTable').DataTable().destroy();
            }
            // Initialize Progress Table
            $('#progressTable').DataTable({

                paging: true,
                searching: false,
                ordering: true,
                info: true,
                pageLength: 10,
                lengthChange: true,
                responsive: true,
                autoWidth: false,

                layout: {
                    topStart: null
                },

                order: [],

                columnDefs: [
                    {
                        targets: 0,   // No column
                        orderable: false
                    }
                ]
            });


            // Destroy old Summary DataTable
            if ($.fn.DataTable.isDataTable('#summaryTable')) {
                $('#summaryTable').DataTable().destroy();
            }


            // Initialize Summary Table
            $('#summaryTable').DataTable({

                paging: false,
                searching: false,
                ordering: false,
                info: false,
                autoWidth: false,

                layout: {
                    topStart: null
                }
            });



            // Add ALL button to bottom paging
            if ($('#progressTable_wrapper #btnShowAll').length === 0) {

                $('#progressTable_wrapper .dt-paging ul').append(`

                    <li class="dt-paging-button page-item">

                        <button id="btnShowAll"
                                type="button"
                                class="page-link">

                            ALL

                        </button>

                    </li>

                `);
            }


            // ALL button click
            $(document)
            .off('click', '#btnShowAll')
            .on('click', '#btnShowAll', function () {

                $('#progressTable')
                    .DataTable()
                    .page
                    .len(-1)
                    .draw();

            });
        }

        $(document).ready(function(){
            $('.select2').select2({
                placeholder:"Select Staff",
                width:"100%",
                closeOnSelect:false
            });
            initializeDataTables();

            $("#ProjectCd").change(function(){


                var projectCd=$(this).val();
                 var staff = $("#StaffCD");

                  staff.val(null).trigger("change");
                staff.empty();

                if(!projectCd)
                {
                  $('#progressTable').DataTable().clear().draw();
                      $('#summaryTable').DataTable().clear().draw();

                        return;
                }
                   

                $.get("/ProjectDetail/GetStaff",
                {
                    projectCd:projectCd

                },

                function(staffList){
                    var staff=$("#StaffCD");
                    staff.empty();

                    $.each(staffList,function(i,item){
                        staff.append(
                            $("<option>",{
                                value:item.value,
                                text:item.text
                            })
                        );
                    });
                    staff.trigger("change");
                });
            });

        

             $("#btnShow").click(function(){


                $.ajax({

                    url:"/ProjectDetail/GetData",

                    type:"POST",

                    data:$("#detailform").serialize(),
                    success:function(result){
                        if(result.success===false){
                            Swal.fire({

                                icon:"warning",

                                title:"Project Required",

                                text:"Please select a project."

                            });
                            return;

                        }
                        $("#tableArea").html(result);
                        initializeDataTables();
                    }
                });
            });
           $(document).on("click", "#btnCancel", function () {
            console.log("Cancel clicked");
              var staff = $("#StaffCD");
                 staff.val(null).trigger("change");
                $("#ProjectCd").val("");
                 staff.empty();
                  $('#progressTable').DataTable().clear().draw();
                      $('#summaryTable').DataTable().clear().draw();

        });
           
            // $(document).on("change","#EndFlag",function(){

            //     if($(this).is(":checked")){
            //         $("#endFlagLabel")
            //         .removeClass("btn-outline-success")
            //         .addClass("btn-success");
            //             $("#endFlagIcon")
            //             .removeClass("fa-square")
            //             .addClass("fa-square-check");
            //     }

            //     else{
            //         $("#endFlagLabel")
            //         .removeClass("btn-success")
            //         .addClass("btn-outline-success");
            //             $("#endFlagIcon")
            //              .removeClass("fa-square-check")
            //              .addClass("fa-square");
            //     }
            // });

            $(document).on("click","#btnSave",function(){
                var data={
                    ProjectCd:$("#ProjectCd").val(),
                    StaffCD:$("#StaffCD").val(),
                    EndFlag:$("#EndFlag").is(":checked"),
                    ProjectProgress:[]
                };
                $("#progressTable tbody tr").each(function(){
                    data.ProjectProgress.push({
                        CustomerCD:$(this)
                        .find(".customerCD")
                        .val(),
                        StaffCD:$(this)
                        .find(".staffCD")
                        .val(),
                        ShopName:$(this)
                        .find(".shopName")
                        .val(),
                        Amount:$(this)
                        .find(".amount")
                        .val(),
                        Active:$(this)
                        .find(".active")
                        .is(":checked"),
                        Remark:$(this)
                        .find(".remark")
                        .val()
                    });
                });

                $.ajax({
                    url:"/ProjectDetail/Save",
                    type:"POST",
                    contentType:"application/json",
                    data:JSON.stringify(data),
                            success: function (response) {

                            Swal.fire({
                                icon: "success",
                                text: response.message
                            }).then(function () {
                                 location.reload();
                           });
                  }
                   
                });
            });
        });
    </script>


}